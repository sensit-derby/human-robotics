---
import { getCollection, render } from "astro:content";
import ProfileLayout from "../../components/ProfileLayout.astro";
import PubList from "../../components/PubList.astro";
import { getPublications, publicationsForPerson } from "../../lib/content";
import { sitePath } from "../../lib/site-path";

export async function getStaticPaths() {
  const people = await getCollection("people");
  return people.map((person) => ({ params: { slug: person.id }, props: { person } }));
}

const { person } = Astro.props;
const { Content } = await render(person);
const hasBio = (person.body ?? "").trim().length > 0;

const pubs = await getPublications();
const mine = publicationsForPerson(person, pubs).slice(0, 15);
---

<ProfileLayout person={person}>
  {
    hasBio && (
      <div class="prose-content space-y-4 leading-relaxed text-slate-700">
        <Content />
      </div>
    )
  }

  {
    mine.length > 0 && (
      <section class:list={[hasBio && "mt-10"]}>
        <div class="mb-1 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 class="font-serif text-xl text-slate-900">Selected publications</h2>
          <a
            href={sitePath(`/publications?author=${encodeURIComponent(person.id)}`)}
            class="text-sm font-medium text-primary-700 hover:underline"
          >Browse publications by {person.data.name}</a>
        </div>
        <PubList pubs={mine} />
      </section>
    )
  }
</ProfileLayout>
