---
import BaseLayout from "../../components/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PersonGroup from "../../components/PersonGroup.astro";
import { getGroupedPeople } from "../../lib/content";

const groups = await getGroupedPeople();
---

<BaseLayout
  title="People"
  description="Meet the Human-Centric Robotics group at the University of Derby."
>
  <PageHeader
    eyebrow="The team"
    title="People"
    lead="Meet the members of Human-Centric Robotics at the University of Derby."
  />
  <div class="container-page py-12">
    {groups.map((g) => <PersonGroup title={g.group} people={g.people} />)}
  </div>
</BaseLayout>
