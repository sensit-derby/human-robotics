---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Facility"
  description={`Research facilities of ${site.name} at the ${site.university}.`}
>
  <PageHeader
    title="Facility"
    lead="Our labs, equipment, and research spaces."
  />

  <div class="container-page py-12">
    <!-- Put your content here -->
    <div class="prose prose-slate max-w-3xl">
      <h2>Lab Overview</h2>
      <p>
        Describe your facilities here. You can add text, images, lists of equipment, etc.
      </p>

      <h2>Equipment</h2>
      <ul>
        <li>Robot arms / platforms</li>
        <li>Sensors / cameras</li>
        <li>Computing resources</li>
      </ul>

      <!-- Example of an image (put images in src/assets/) -->
      <!-- 
      <Image src={...} alt="Lab photo" />
      -->
    </div>
  </div>
</BaseLayout>
