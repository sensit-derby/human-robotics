---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { facilities } from "../data/facilities";
import { sitePath } from "../lib/site-path";

const people = new Map((await getCollection("people")).map((person) => [person.id, person.data]));

function getContact(slug: string) {
  const person = people.get(slug);
  if (!person) throw new Error(`Missing facility contact profile: ${slug}`);
  return {
    name: person.name,
    href: person.links.email ? `mailto:${person.links.email}` : sitePath(`/people/${slug}`),
  };
}
---

<BaseLayout
  title="Facility"
  description="Robotic systems, sensors, and prototyping and computing equipment available to the HCR Group at the University of Derby."
>
  <PageHeader
    title="Facility"
    lead="Explore the robotics, sensing, and prototyping equipment used by the HCR Group. Contact the person listed for access or collaboration enquiries."
  />
  <div class="container-page space-y-14 py-12">
    {facilities.map(({ category, equipment }) => (
      <section>
        <h2 class="mb-5 font-serif text-2xl font-semibold text-slate-900">{category}</h2>
        <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {equipment.map((item) => (
            <li class="flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white">
              <div class="aspect-[4/3] border-b border-slate-100 bg-white p-4">
                <Image
                  src={item.image}
                  alt={item.alt ?? item.name}
                  widths={[360, 720]}
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  class="h-full w-full object-contain"
                />
              </div>
              <div class="flex grow flex-col p-5">
                <h3 class="font-serif text-xl text-slate-900">{item.name}</h3>
                <p class="mb-4 mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>
                <div class="mt-auto text-sm">
                  <p class="font-medium text-slate-700">{item.contacts.length === 1 ? "Equipment contact" : "Equipment contacts"}</p>
                  <ul class="mt-1 flex flex-wrap gap-x-3 gap-y-1">
                    {item.contacts.map(getContact).map(({ name, href }) => (
                      <li><a class="text-primary-700 underline-offset-2 hover:underline" href={href}>{name}</a></li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
