---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { site } from "../data/site";
import { getGroupedPeople } from "../lib/content";

const people = (await getGroupedPeople())
  .flatMap(({ people }) => people)
  .filter(({ data }) => data.status === "current");
---

<BaseLayout
  title="Contact"
  description={`Contact ${site.name} at the ${site.university}.`}
>
  <PageHeader
    title="Contact"
    lead="Get in touch with the Human-Centric Robotics group about research collaboration."
  />
  <div class="container-page py-12">
    <div class="grid max-w-3xl gap-6 sm:grid-cols-2">
      {people.map(({ data: { name, role, links } }) => (
        <section class="rounded-xl border border-slate-200 p-6">
          <h2 class="font-serif text-xl text-slate-900">{name}</h2>
          <p class="mt-2 text-sm text-slate-600">{role}</p>
          <ul class="mt-4 space-y-2 text-sm text-primary-700">
            {links.email && <li><a href={`mailto:${links.email}`} class="hover:underline">{links.email}</a></li>}
            {links.website && <li><a href={links.website} class="hover:underline">Website</a></li>}
          </ul>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
