---
import { site } from "../data/site";
import { sitePath } from "../lib/site-path";

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-200 bg-slate-50">
  <div class="container-page flex flex-wrap items-start justify-between gap-8 py-10">
    <div>
      <p class="font-serif text-lg text-slate-900">{site.name} ({site.shortName})</p>
      <p class="mt-2 text-sm text-slate-600">{site.university}</p>
    </div>
    <a href={sitePath("/contact")} class="text-sm font-medium text-primary-700 hover:underline">
      Contact the group
    </a>
  </div>

  <div class="border-t border-slate-200">
    <div class="container-page py-4 text-xs text-slate-600">
      <p>© {year} {site.name}.</p>
    </div>
  </div>
</footer>
